# Android device access for adb / fastboot.
#
# Grants the locally logged-in desktop user access to the raw USB device via
# systemd's uaccess ACL (no group membership required, which matters on an
# image where the user account is only created at install time). GROUP=dialout
# is set as a fallback for non-seat sessions. Vendor IDs track the community
# android-udev-rules list. (udev has no inline comments, so vendor names sit on
# their own lines above each rule.)

SUBSYSTEM!="usb", GOTO="android_rules_end"
ACTION!="add", GOTO="android_rules_end"

# NEC
ATTR{idVendor}=="0409", TAG+="uaccess", GROUP="dialout", MODE="0660"
# Gigabyte
ATTR{idVendor}=="0414", TAG+="uaccess", GROUP="dialout", MODE="0660"
# Kyocera
ATTR{idVendor}=="0482", TAG+="uaccess", GROUP="dialout", MODE="0660"
